# --- App ---
PROJECT_NAME="NewMonolioPokemon API"
ENVIRONMENT=local           # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# --- PostgreSQL ---
# Opcion A: define las piezas por separado y el DSN se construye solo
POSTGRES_HOST=localhost
POSTGRES_PORT=5435          # el que publica docker-compose en el host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newmonoliopokemon

# Opcion B: define DATABASE_URL directamente y se ignoran las variables POSTGRES_*.
# Usa el driver async (+asyncpg): el seeder lo convierte a +psycopg2 por su cuenta.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/newmonoliopokemon

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
